# Copy to .env only when you want to go beyond the local demo. Never commit .env.
# Without these values the server runs in demo mode: WhatsApp messages are written to the outbox, not sent.

# --- WhatsApp Business Cloud API (Meta). All three are needed for real sending.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Graph API version, check https://developers.facebook.com/docs/graph-api/changelog (example: v22.0)
WHATSAPP_API_VERSION=

# --- Real channel calendars (iCal export links from Booking.com / Airbnb / your PMS).
# JSON: {"booking":{"name":"Booking.com","feeds":{"economy":"https://…ics","triple":"https://…ics"}}}
# Leave empty to use the built-in mock Booking.com.
CHANNEL_FEEDS_JSON=

# --- Server (the server only ever listens on 127.0.0.1)
PORT=4171
